{
  "scenario_id": "first_turn_quality_reject",
  "scenario_name": "First Turn Quality Reject - Zero Side Effects",
  "description": "First turn where quality gate rejects. Zero CardState/TurnRecord/Memory writes.",
  "suite": "first-turn",
  "requires_comfyui": false,
  "input_fixtures": {
    "session_id": "s_first_002",
    "logical_card_id": "card_village_001",
    "card_version": 1,
    "source_hash": "abc123def456",
    "player_input": "你好",
    "greeting_id": "g0",
    "quality_verdict": "reject"
  },
  "node_expectations": [
    {
      "node_class": "AWPV2FirstTurnRequest",
      "execution_status": "executed",
      "business_disposition": "produced_result",
      "semantic_health": "passed"
    },
    {
      "node_class": "AWPV2SessionReadyValidator",
      "execution_status": "executed",
      "business_disposition": "produced_result",
      "semantic_health": "passed"
    },
    {
      "node_class": "AWPV2FirstTurnExecution",
      "execution_status": "executed",
      "business_disposition": "produced_result",
      "semantic_health": "passed"
    },
    {
      "node_class": "AWPV2FirstTurnReceipt",
      "execution_status": "executed",
      "business_disposition": "produced_result",
      "semantic_health": "warning"
    }
  ],
  "side_effect_expectations": [
    {
      "store": "card_state",
      "operation": "commit",
      "must_be_zero": true,
      "description": "Quality reject must not commit CardState"
    },
    {
      "store": "turn_record",
      "operation": "save",
      "must_be_zero": true,
      "description": "Quality reject must not save TurnRecord"
    },
    {
      "store": "active_memory",
      "operation": "upsert",
      "must_be_zero": true,
      "description": "Quality reject must not write active memory"
    },
    {
      "store": "rag_memory",
      "operation": "save",
      "must_be_zero": true,
      "description": "Quality reject must not write RAG memory"
    }
  ]
