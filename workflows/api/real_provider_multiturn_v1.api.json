{
  "prompt": {
    "1": {
      "class_type": "AWPV2CardImportAndBootstrap",
      "inputs": {
        "source_path": "{{card_path}}",
        "session_id": "{{session_id}}",
        "greeting_id": "g0",
        "request_id": "{{request_id}}_bootstrap",
        "run_id": "{{run_id}}_bootstrap",
        "workflow_run_id": "{{workflow_run_id}}",
        "trace_id": "{{trace_id}}",
        "initial_state_seed": "{}"
      }
    },
    "2": {
      "class_type": "AWPV2CardStateInit",
      "inputs": {
        "card_id": "{{logical_card_id}}",
        "session_id": "{{session_id}}",
        "greeting": ""
      }
    },
    "3": {
      "class_type": "AWPV2CardDefinitionFixtureLoad",
      "inputs": {
        "fixture_path": "test_fixtures/ready_card_definition.json"
      }
    },
    "4": {
      "class_type": "{{turn_execution_node}}",
      "inputs": {
        "session_id": "{{session_id}}",
        "player_input": "{{player_input}}",
        "logical_card_id": "{{logical_card_id}}",
        "card_version": 1,
        "source_hash": "{{source_hash}}",
        "card_state": ["2", 0],
        "card_session_binding": ["1", 0],
        "opening_record": ["1", 1],
        "worldbook_binding": ["1", 2],
        "card_definition": ["3", 0],
        "workflow_run_id": "{{workflow_run_id}}",
        "trace_id": "{{trace_id}}",
        "turn_id": "{{turn_id}}",
        "attempt_id": "{{attempt_id}}",
        "request_id": "{{request_id}}",
        "run_id": "{{run_id}}",
        "director_model": "{{director_model}}",
        "writer_model": "{{writer_model}}",
        "previous_turn_records": "{{previous_turn_records}}",
        "turn_index": "{{turn_index}}"
      }
    },
    "5": {
      "class_type": "AWPV2TurnResultProbe",
      "inputs": {
        "receipt": ["4", 0],
        "diagnostics": ["4", 2],
        "turn_record": ["4", 4],
        "prompt_id": "{{prompt_id}}",
        "turn_kind": "{{turn_kind}}"
      }
    }
  }
}
