{
  "prompt": {
    "1": {
      "class_type": "AWPV2CardImportAndBootstrap",
      "inputs": {
        "source_path": "{{card_path}}",
        "session_id": "{{session_id}}",
        "greeting_id": "g0",
        "request_id": "{{request_id}}_bootstrap",
        "run_id": "{{run_id}}_bootstrap",
        "workflow_run_id": "{{workflow_run_id}}",
        "trace_id": "{{trace_id}}",
        "initial_state_seed": "{}"
      }
    },
    "2": {
      "class_type": "AWPV2FirstTurnExecution",
      "inputs": {
        "session_id": "{{session_id}}",
        "player_input": "{{player_input}}",
        "logical_card_id": "{{logical_card_id}}",
        "card_version": 1,
        "source_hash": "{{source_hash}}",
        "card_state": ["1", 3],
        "card_session_binding": ["1", 0],
        "opening_record": ["1", 1],
        "worldbook_binding": ["1", 2],
        "card_definition": ["1", 4],
        "workflow_run_id": "{{workflow_run_id}}",
        "trace_id": "{{trace_id}}",
        "turn_id": "{{turn_id}}",
        "attempt_id": "{{attempt_id}}",
        "request_id": "{{request_id}}",
        "run_id": "{{run_id}}"
      }
    },
    "3": {
      "class_type": "AWPV2TraceDisplay",
      "inputs": {
        "data": ["2", 2],
        "label": "Turn Diagnostics"
      }
    },
    "4": {
      "class_type": "AWPV2TraceDisplay",
      "inputs": {
        "data": ["2", 1],
        "label": "First Turn Context"
      }
    }
  }
}
