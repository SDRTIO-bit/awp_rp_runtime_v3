{
  "name": "AWP RP V2 — Memory Curator Agent (D6)",
  "description": "官方工作流：Memory Curator Agent V1 — 回合后段记忆治理",
  "version": "2.0",
  "schema_version": 1,
  "nodes": [
    {
      "id": 1,
      "type": "AWPV2RoundSnapshotBuilder",
      "title": "构建回合快照",
      "inputs": {},
      "outputs": ["ROUND_SNAPSHOT"]
    },
    {
      "id": 2,
      "type": "AWPV2Director",
      "title": "Director 主控",
      "inputs": {"round_snapshot": "1.ROUND_SNAPSHOT"},
      "outputs": ["TURN_BRIEF", "DELEGATION_PLAN"]
    },
    {
      "id": 3,
      "type": "AWPV2DynamicSubAgentPool",
      "title": "动态子Agent池",
      "inputs": {"delegation_plan": "2.DELEGATION_PLAN", "round_snapshot": "1.ROUND_SNAPSHOT"},
      "outputs": ["EXECUTION_RESULTS"]
    },
    {
      "id": 4,
      "type": "AWPV2SuggestionMerge",
      "title": "建议合并",
      "inputs": {"delegation_plan": "2.DELEGATION_PLAN", "turn_brief": "2.TURN_BRIEF", "execution_results": "3.EXECUTION_RESULTS"},
      "outputs": ["SUGGESTION_MERGE_RESULT"]
    },
    {
      "id": 5,
      "type": "AWPV2Writer",
      "title": "Writer 正文生成",
      "inputs": {"round_snapshot": "1.ROUND_SNAPSHOT", "turn_brief": "2.TURN_BRIEF", "suggestion_merge_result": "4.SUGGESTION_MERGE_RESULT"},
      "outputs": ["ACCEPTED_TEXT"]
    },
    {
      "id": 6,
      "type": "AWPV2QualityGate",
      "title": "质量门",
      "inputs": {"accepted_text": "5.ACCEPTED_TEXT", "round_snapshot": "1.ROUND_SNAPSHOT"},
      "outputs": ["QUALITY_DECISION"]
    },
    {
      "id": 7,
      "type": "AWPV2StateProposal",
      "title": "状态提案",
      "inputs": {"accepted_text": "5.ACCEPTED_TEXT", "round_snapshot": "1.ROUND_SNAPSHOT", "quality_decision": "6.QUALITY_DECISION"},
      "outputs": ["STATE_UPDATE_PROPOSAL"]
    },
    {
      "id": 8,
      "type": "AWPV2CardStateCommit",
      "title": "CardState 提交",
      "inputs": {"state_update_proposal": "7.STATE_UPDATE_PROPOSAL", "quality_decision": "6.QUALITY_DECISION", "round_snapshot": "1.ROUND_SNAPSHOT"},
      "outputs": ["CARD_STATE_COMMIT_RESULT"]
    },
    {
      "id": 9,
      "type": "AWPV2TurnRecordCommit",
      "title": "TurnRecord 提交",
      "inputs": {"accepted_text": "5.ACCEPTED_TEXT", "quality_decision": "6.QUALITY_DECISION", "round_snapshot": "1.ROUND_SNAPSHOT", "card_state_commit_result": "8.CARD_STATE_COMMIT_RESULT"},
      "outputs": ["TURN_RECORD"]
    },
    {
      "id": 10,
      "type": "AWPV2MemoryCurationTrigger",
      "title": "记忆治理触发",
      "inputs": {"quality_decision": "6.QUALITY_DECISION", "turn_record_committed": true, "card_state_commit_result": "8.CARD_STATE_COMMIT_RESULT", "turn_record": "9.TURN_RECORD", "round_snapshot": "1.ROUND_SNAPSHOT"},
      "outputs": ["TRIGGER_DIAGNOSTICS"]
    },
    {
      "id": 11,
      "type": "AWPV2MemoryCuratorAgent",
      "title": "Memory Curator Agent",
      "inputs": {"quality_decision": "6.QUALITY_DECISION", "turn_record": "9.TURN_RECORD", "round_snapshot": "1.ROUND_SNAPSHOT", "card_state_commit_result": "8.CARD_STATE_COMMIT_RESULT"},
      "outputs": ["CURATION_RESULT", "CURATION_TRIGGER_DIAGNOSTICS"]
    },
    {
      "id": 12,
      "type": "AWPV2MemoryCurationValidator",
      "title": "记忆候选验证",
      "inputs": {"curation_result": "11.CURATION_RESULT", "curation_request": "11.CURATION_RESULT"},
      "outputs": ["VALIDATED_RESULT"]
    },
    {
      "id": 13,
      "type": "AWPV2MemoryCurationRanker",
      "title": "记忆候选排序",
      "inputs": {"curation_result": "12.VALIDATED_RESULT"},
      "outputs": ["RANKED_RESULT"]
    },
    {
      "id": 14,
      "type": "AWPV2MemoryCurationCommitPlan",
      "title": "记忆提交计划编译",
      "inputs": {"curation_result": "13.RANKED_RESULT", "turn_id": "9.TURN_RECORD", "round_snapshot": "1.ROUND_SNAPSHOT", "quality_decision": "6.QUALITY_DECISION"},
      "outputs": ["MEMORY_COMMIT_PLAN"]
    },
    {
      "id": 15,
      "type": "AWPV2ActiveMemoryCommit",
      "title": "ActiveMemory 提交",
      "inputs": {"memory_commit_plan": "14.MEMORY_COMMIT_PLAN", "quality_decision": "6.QUALITY_DECISION", "card_state_commit_result": "8.CARD_STATE_COMMIT_RESULT", "turn_record_commit_result": "9.TURN_RECORD"},
      "outputs": ["ACTIVE_MEMORY_COMMIT_RESULT"]
    },
    {
      "id": 16,
      "type": "AWPV2RagMemoryCommit",
      "title": "RAG Memory 提交",
      "inputs": {"memory_commit_plan": "14.MEMORY_COMMIT_PLAN", "quality_decision": "6.QUALITY_DECISION", "card_state_commit_result": "8.CARD_STATE_COMMIT_RESULT", "turn_record_commit_result": "9.TURN_RECORD"},
      "outputs": ["RAG_MEMORY_COMMIT_RESULT"]
    },
    {
      "id": 17,
      "type": "AWPV2MemoryCurationDiagnostics",
      "title": "记忆治理诊断",
      "inputs": {"curation_result": "11.CURATION_RESULT", "trigger_diagnostics": "11.CURATION_TRIGGER_DIAGNOSTICS"},
      "outputs": ["DIAGNOSTICS"]
    }
  ],
  "connections": [
